<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- A rule's actions are any combination of category / merchant /
         auto-approve, so the category becomes optional. -->
    <changeSet id="017-rule-optional-category" author="joao">
        <dropNotNullConstraint tableName="rules" columnName="category_id" columnDataType="bigint"/>
    </changeSet>

</databaseChangeLog>
