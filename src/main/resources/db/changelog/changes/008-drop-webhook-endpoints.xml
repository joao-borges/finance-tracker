<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Drop the unused configurable-webhook tables; notifications are Discord-only now. -->

    <changeSet id="008-drop-webhook-endpoint-events" author="finance">
        <dropTable tableName="webhook_endpoint_events"/>
    </changeSet>

    <changeSet id="008-drop-webhook-endpoints" author="finance">
        <dropTable tableName="webhook_endpoints"/>
    </changeSet>

</databaseChangeLog>
