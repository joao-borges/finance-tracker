<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- One-time budget categories: a category that belongs to a single month
         (a one-off expense you still want as its own budget line), instead of
         living forever in the category list. -->
    <changeSet id="023-one-time-categories" author="joao">
        <addColumn tableName="categories">
            <column name="one_time_month" type="varchar(7)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
