<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      Stores the long-lived SimpleFIN access URL (claimed once from a setup
      token). Self-hosted single-row config; the access URL is a secret that
      lives only in this DB, never in the repo.
    -->
    <changeSet id="010-create-simplefin-connection" author="finance">
        <createTable tableName="simplefin_connection">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="access_url" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="last_synced_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
