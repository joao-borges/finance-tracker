# Copy to .env and adjust. docker-compose reads these. Never commit the real .env.
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me

# Discord channel webhook for import notifications (leave blank to disable).
DISCORD_WEBHOOK_URL=

# Floor for the AUTOMATIC SimpleFIN sync window (ISO date, UTC). Operator-driven
# imports (CSV, explicit date range, manual entry) ignore it. Blank = no floor.
IMPORT_MIN_POSTED_DATE=2026-06-01

# Google sign-in (prod). Without SPRING_PROFILES_ACTIVE=oauth, auth is disabled.
SPRING_PROFILES_ACTIVE=oauth
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxx
# Comma-separated Google emails allowed to sign in.
FINANCE_AUTH_ALLOWED_EMAILS=you@gmail.com
